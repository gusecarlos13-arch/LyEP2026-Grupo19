# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.

# Puerto del servidor
PORT=3001

# Cadena de conexión de MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/panel_clientes?retryWrites=true&w=majority

# Dirección del frontend que puede consumir la API (separar con coma si son varias)
CLIENT_URL=http://localhost:5173
